# Copy to secrets.env (git-ignored). Prefer an external secret manager
# (External Secrets, Sealed Secrets, SOPS) over a plain file in production.
# verify-full checks the server certificate. sslrootcert=system trusts the OS CAs;
# if your provider signs with its own CA (e.g. AWS RDS), point sslrootcert at its bundle.
PERSONAL_AI_DATABASE_URL=postgres://user:password@your-db-host:5432/personal_ai?sslmode=verify-full&sslrootcert=system
PERSONAL_AI_MANAGEMENT_TOKEN=
PERSONAL_AI_INFERENCE_TOKEN=
PERSONAL_AI_RUNTIME_KEY_SECRET=
PERSONAL_AI_RUNPOD_API_KEY=
PERSONAL_AI_TELEGRAM_TOKEN=
PERSONAL_AI_HF_TOKEN=
